{
  "entities": {
    "IDCardDesign": {
      "title": "ID Card Design",
      "description": "Customizable, saved layout blueprints and templates for student or staff ID cards",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "template": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "template"]
    },
    "WhatsAppCommunity": {
      "title": "WhatsApp Community",
      "description": "WhatsApp Community Announcement Group configuration",
      "type": "object",
      "properties": {
        "communityJid": { "type": "string" },
        "associatedClasses": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["communityJid", "associatedClasses"]
    },
    "WhatsAppMetadata": {
      "title": "WhatsApp Metadata",
      "description": "Locking and status information for WhatsApp connection instance",
      "type": "object",
      "properties": {
        "instanceId": { "type": "string" },
        "updatedAt": { "type": "string" },
        "pid": { "type": "number" },
        "hostname": { "type": "string" },
        "cooldownUntil": { "type": "number" }
      }
    },
    "WhatsAppSession": {
      "title": "WhatsApp Session",
      "description": "Multi-device authentication state stored in Firestore",
      "type": "object",
      "properties": {
        "creds": { "type": "string", "description": "JSON string of auth credentials" },
        "updatedAt": { "type": "string" }
      }
    },
    "WhatsAppKey": {
      "title": "WhatsApp Session Key",
      "description": "Individual cryptographic keys for WhatsApp session",
      "type": "object",
      "properties": {
        "data": { "type": "string", "description": "JSON string of key data" },
        "updatedAt": { "type": "string" }
      }
    },
    "WhatsAppQueue": {
      "title": "WhatsApp Message Queue",
      "description": "Pending messages for persistent delivery",
      "type": "object",
      "properties": {
        "to": { "type": "string" },
        "text": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "processing", "sent", "failed"] },
        "retryCount": { "type": "number" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      }
    },
    "WhatsAppBotMenu": {
      "title": "WhatsApp Bot Menu",
      "description": "Configurable interactive menu for the WhatsApp bot",
      "type": "object",
      "properties": {
        "keyword": { "type": "string", "description": "Trigger keyword (e.g., 'fees', 'menu')" },
        "responseText": { "type": "string", "description": "The message text to send" },
        "buttons": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "text": { "type": "string" }
            }
          }
        },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      }
    },
    "AttendanceAlertsSent": {
      "title": "Attendance Alerts Sent",
      "description": "Sentinel log to prevent duplicate sending of attendance alerts by date",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "sentAt": { "type": "string", "format": "date-time" },
        "count": { "type": "number" },
        "studentIds": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "UserIdentity": {
      "title": "User Identity",
      "description": "Essential Auth and Identity data",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "description": "Firebase Auth UID" },
        "email": { "type": "string", "format": "email", "description": "User email address" },
        "name": { "type": "string", "description": "User display name" },
        "role": { 
          "type": "string", 
          "enum": ["admin", "vice_principal", "teacher", "student", "accountant", "clerk", "parent"],
          "description": "User role for access control"
        },
        "photoURL": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "pushToken": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role", "name"]
    },
    "StudentProfile": {
      "title": "Student Profile",
      "description": "Detailed academic and personal data for students",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "admissionNumber": { "type": "string" },
        "rollNumber": { "type": "string" },
        "classId": { "type": "string" },
        "batchId": { "type": "string" },
        "gender": { "type": "string", "enum": ["male", "female", "other"] },
        "dateOfBirth": { "type": "string", "format": "date" },
        "bloodGroup": { "type": "string" },
        "admissionDate": { "type": "string", "format": "date" },
        "parentName": { "type": "string" },
        "parentEmail": { "type": "string", "format": "email" },
        "contact": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "address": { "type": "string" },
        "city": { "type": "string" },
        "state": { "type": "string" },
        "zipCode": { "type": "string" },
        "studentAadharNumber": { "type": "string" },
        "motherAadharNumber": { "type": "string" },
        "fatherAadharNumber": { "type": "string" },
        "motherBankDetails": {
          "type": "object",
          "properties": {
            "accountNumber": { "type": "string" },
            "bankName": { "type": "string" },
            "ifscCode": { "type": "string" }
          }
        },
        "transportType": { "type": "string", "enum": ["school", "private"] },
        "feeType": { "type": "string", "enum": ["hostel", "day_schooler"] },
        "feeConcessionType": { "type": "string" },
        "faceDescriptor": { "type": "array", "items": { "type": "number" } },
        "lastClassFeeDue": { "type": "number" },
        "siblingKey": { "type": "string" },
        "studentSubCaste": { "type": "string" },
        "religion": { "type": "string" }
      }
    },
    "StaffProfile": {
      "title": "Staff Profile",
      "description": "Detailed professional data for staff",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "staffId": { "type": "string" },
        "designation": { "type": "string" },
        "department": { "type": "string" },
        "salary": { "type": "number" },
        "qualifications": { "type": "string" },
        "gender": { "type": "string" },
        "contact": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "address": { "type": "string" },
        "joiningDate": { "type": "string" }
      }
    },
    "SchoolSettings": {
      "title": "School Settings",
      "description": "Global settings for the school institution",
      "type": "object",
      "properties": {
        "schoolName": { "type": "string", "description": "Name of the school" },
        "logoUrl": { "type": "string", "description": "URL or base64 of the school logo" },
        "address": { "type": "string", "description": "Physical address" },
        "contactEmail": { "type": "string", "format": "email", "description": "Primary contact email" },
        "phone": { "type": "string", "description": "Contact phone number" },
        "website": { "type": "string", "description": "School website URL" },
        "principalName": { "type": "string", "description": "Name of the principal" },
        "establishedYear": { "type": "string", "description": "Year the school was founded" },
        "affiliationNumber": { "type": "string", "description": "School affiliation ID" },
        "currentAcademicYear": { "type": "string", "description": "The current default academic year" },
        "academicYears": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of all defined academic years"
        },
        "aiApiKey": { "type": "string", "description": "Linked AI Model API Key for deep analysis" },
        "aiApiKeyEnabled": { "type": "boolean", "description": "Global toggle for AI API usage" },
        "aiSpending": { "type": "number", "description": "Real-time AI usage cost in INR (₹)" }
      },
      "required": ["schoolName", "logoUrl", "currentAcademicYear"]
    },
    "AIInsight": {
      "title": "AI Insight",
      "description": "Strategic insights generated by AI analyzing multi-dimensional school data",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string", "enum": ["high", "medium", "good"] },
        "tags": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "description", "priority", "createdAt"]
    },
    "Class": {
      "title": "Class",
      "description": "Academic classes (e.g., Grade 10)",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "description": { "type": "string" }
      },
      "required": ["name", "code"]
    },
    "Batch": {
      "title": "Batch",
      "description": "Sections or batches within a class",
      "type": "object",
      "properties": {
        "classId": { "type": "string" },
        "name": { "type": "string" },
        "classTeacherId": { "type": "string" }
      },
      "required": ["classId", "name"]
    },
    "Subject": {
      "title": "Subject",
      "description": "Academic subjects",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "code": { "type": "string" },
        "type": { "type": "string", "enum": ["theory", "practical", "both"] }
      },
      "required": ["name", "code", "type"]
    },
    "Exam": {
      "title": "Exam",
      "description": "Scheduled examinations (FA-1 to FA-4, SA-1, SA-2)",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["FA", "SA"] },
        "examNumber": { "type": "number", "description": "1, 2, 3, or 4" },
        "date": { "type": "string", "format": "date" },
        "academicYear": { "type": "string" },
        "status": { "type": "string", "enum": ["scheduled", "ongoing", "completed", "published"] }
      },
      "required": ["title", "type", "examNumber", "academicYear", "status"]
    },
    "ExamMark": {
      "title": "Exam Mark",
      "description": "Student marks for a specific subject and exam",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "studentId": { "type": "string" },
        "subjectId": { "type": "string" },
        "classId": { "type": "string" },
        "batchId": { "type": "string" },
        "st1": { "type": "number", "description": "Slip Test 1 (max 10)" },
        "st2": { "type": "number", "description": "Slip Test 2 (max 10)" },
        "hw": { "type": "number", "description": "Homework (max 5)" },
        "faWritten": { "type": "number", "description": "FA Written Test (max 25)" },
        "saWritten": { "type": "number", "description": "SA Written Test (max 100)" },
        "total": { "type": "number" },
        "isAbsent": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["examId", "studentId", "subjectId", "classId", "batchId"]
    },
    "ExamSchedule": {
      "title": "Exam Schedule",
      "description": "Subject-wise timetable for a specific exam and batch",
      "type": "object",
      "properties": {
        "examId": { "type": "string" },
        "batchId": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "time": { "type": "string" },
        "duration": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["examId", "batchId", "subjectId"]
    },
    "Class10DailySchedule": {
      "title": "Class 10 Daily Exam Schedule",
      "description": "Daily exam schedule for Class 10 (1 subject per day with topic and max marks)",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "classId": { "type": "string" },
        "batchId": { "type": "string" },
        "subjectId": { "type": "string" },
        "subjectName": { "type": "string" },
        "maxMarks": { "type": "number" },
        "topic": { "type": "string" },
        "teacherId": { "type": "string" },
        "teacherName": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "classId", "subjectId", "maxMarks"]
    },
    "Class10DailyMark": {
      "title": "Class 10 Daily Exam Mark",
      "description": "Daily exam marks entry for Class 10 student with subject comparison",
      "type": "object",
      "properties": {
        "scheduleId": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "classId": { "type": "string" },
        "batchId": { "type": "string" },
        "subjectId": { "type": "string" },
        "studentId": { "type": "string" },
        "marksObtained": { "type": "number" },
        "maxMarks": { "type": "number" },
        "percentage": { "type": "number" },
        "grade": { "type": "string" },
        "isAbsent": { "type": "boolean" },
        "enteredBy": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["scheduleId", "studentId", "subjectId", "date"]
    },
    "Timetable": {
      "title": "Timetable",
      "description": "Weekly schedule for a batch",
      "type": "object",
      "properties": {
        "batchId": { "type": "string" },
        "day": { "type": "string", "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"] },
        "periods": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "startTime": { "type": "string" },
              "endTime": { "type": "string" },
              "subjectId": { "type": "string" },
              "teacherId": { "type": "string" },
              "isBreak": { "type": "boolean" },
              "label": { "type": "string" }
            }
          }
        }
      },
      "required": ["batchId", "day", "periods"]
    },
    "Substitution": {
      "title": "Substitution",
      "description": "Daily substitution records for absent teachers",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "absentTeacherId": { "type": "string" },
        "substituteTeacherId": { "type": "string" },
        "periodIndex": { "type": "number" },
        "batchId": { "type": "string" },
        "subjectId": { "type": "string" },
        "status": { "type": "string", "enum": ["pending", "notified", "completed"] }
      },
      "required": ["date", "absentTeacherId", "substituteTeacherId", "periodIndex", "batchId"]
    },
    "TimetableSettings": {
      "title": "Timetable Settings",
      "description": "Global configuration for period slots and timings",
      "type": "object",
      "properties": {
        "slots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": { "type": "string" },
              "start": { "type": "string" },
              "end": { "type": "string" },
              "isBreak": { "type": "boolean" }
            }
          }
        }
      },
      "required": ["slots"]
    },
    "Attendance": {
      "title": "Attendance",
      "description": "Daily attendance records",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "staffId": { "type": "string", "description": "Optional staff ID if attendance is for staff" },
        "date": { "type": "string", "format": "date" },
        "status": { "type": "string", "enum": ["present", "absent", "late"] },
        "method": { "type": "string", "enum": ["manual", "face"], "description": "How the attendance was recorded" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["date", "status"]
    },
    "Payment": {
      "title": "Payment",
      "description": "Fee payment records",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "amount": { "type": "number" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["tuition", "hostel", "transport", "other"] },
        "status": { "type": "string", "enum": ["paid", "pending"] },
        "academicYear": { "type": "string" }
      },
      "required": ["studentId", "amount", "date", "status"]
    },
    "MessageTemplate": {
      "title": "Message Template",
      "description": "Customizable templates for WhatsApp/SMS messages",
      "type": "object",
      "properties": {
        "event": { "type": "string", "enum": ["absent", "fee_reminder", "fee_receipt", "attendance_summary", "exam_marks", "salary_credit", "broadcast", "holiday"] },
        "name": { "type": "string" },
        "content": { "type": "string" },
        "placeholders": { "type": "array", "items": { "type": "string" } },
        "isActive": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["event", "name", "content"]
    },
    "BirthdayTemplate": {
      "title": "Birthday Template",
      "description": "Templates for birthday wishes",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "content": { "type": "string" },
        "type": { "type": "string", "enum": ["student", "staff", "general"] },
        "isDefault": { "type": "boolean" }
      },
      "required": ["name", "content", "type"]
    },
    "Holiday": {
      "title": "School Holiday",
      "description": "Calendar of school holidays and working Saturdays",
      "type": "object",
      "properties": {
        "date": { "type": "string", "format": "date" },
        "title": { "type": "string" },
        "type": { "type": "string", "enum": ["holiday", "working_day", "event"] },
        "description": { "type": "string" }
      },
      "required": ["date", "title", "type"]
    },
    "WhatsAppLog": {
      "title": "WhatsApp Message Log",
      "description": "Tracks delivery status of sent messages",
      "type": "object",
      "properties": {
        "recipient": { "type": "string" },
        "text": { "type": "string" },
        "status": { "type": "string", "enum": ["queued", "sent", "delivered", "failed"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "error": { "type": "string" },
        "type": { "type": "string", "enum": ["single", "broadcast", "birthday", "bot"] }
      },
      "required": ["recipient", "text", "status", "timestamp", "type"]
    },
    "WhatsAppStats": {
      "title": "WhatsApp Stats",
      "description": "Aggregated statistics for WhatsApp communication",
      "type": "object",
      "properties": {
        "total": { "type": "number" },
        "delivered": { "type": "number" },
        "sent": { "type": "number" },
        "failed": { "type": "number" },
        "processing": { "type": "number" },
        "types": { "type": "object" },
        "updatedAt": { "type": "string" }
      }
    },
    "FeeRecord": {
      "title": "Fee Record",
      "description": "Student's overall fee status for an academic year",
      "type": "object",
      "properties": {
        "studentId": { "type": "string" },
        "academicYear": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paidAmount": { "type": "number" },
        "status": { "type": "string", "enum": ["paid", "partial", "pending"] },
        "dueDate": { "type": "string", "format": "date" },
        "oldFee": { "type": "number" },
        "oldFeeConcession": { "type": "number" },
        "paidComponents": { "type": "object" }
      },
      "required": ["studentId", "totalAmount", "paidAmount", "status"]
    },
    "CustomRole": {
      "title": "Custom Role",
      "description": "Defines fine-grained permissions for user roles",
      "type": "object",
      "properties": {
        "name": { "type": "string", "description": "Role name" },
        "description": { "type": "string" },
        "permissions": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "List of permission IDs"
        },
        "isAdmin": { "type": "boolean" },
        "isSystem": { "type": "boolean" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "permissions", "createdAt", "updatedAt"]
    },
    "SchoolBus": {
      "title": "School Bus",
      "type": "object",
      "properties": {
        "busNumber": { "type": "string" },
        "driverName": { "type": "string" },
        "driverPhone": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "maintenance", "on-road"] },
        "currentLat": { "type": "number" },
        "currentLng": { "type": "number" },
        "lastUpdate": { "type": "string" }
      }
    },
    "TransportStop": {
      "title": "Transport Stop",
      "type": "object",
      "properties": {
        "busId": { "type": "string" },
        "villageName": { "type": "string" },
        "fee": { "type": "number" },
        "latitude": { "type": "number" },
        "longitude": { "type": "number" },
        "order": { "type": "number" }
      }
    },
    "Notice": {
      "title": "Notice",
      "description": "Public or internal notices for the school",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "authorId": { "type": "string" },
        "targetRoles": { 
          "type": "array", 
          "items": { "type": "string" },
          "description": "Roles that can see this notice (e.g. ['all'], ['teacher', 'student'])"
        },
        "priority": { "type": "string", "enum": ["low", "medium", "high", "critical"] },
        "isPublic": { "type": "boolean", "description": "Whether to show on the landing page" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["title", "content", "authorId", "targetRoles", "createdAt"]
    },
    "CalendarEvent": {
      "title": "Calendar Event",
      "description": "Scheduled school events, holidays, and exams on the academic calendar",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "date": { "type": "string", "format": "date" },
        "type": { "type": "string", "enum": ["event", "holiday", "exam"] },
        "description": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "location": { "type": "string" }
      },
      "required": ["title", "date", "type"]
    },
    "SiteConfig": {
      "title": "Site Configuration",
      "description": "CMS settings for the public landing page",
      "type": "object",
      "properties": {
        "hero": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "backgroundImage": { "type": "string" }
          }
        },
        "about": {
          "type": "object",
          "properties": {
            "prefix": { "type": "string" },
            "title": { "type": "string" },
            "text": { "type": "string" },
            "gridPhotos": { "type": "array", "items": { "type": "string" } },
            "stats": {
              "type": "array",
              "items": {
